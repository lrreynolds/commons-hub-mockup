{
  "mastodon_defaults_version": "1.1",
  "platform": "mastodon",
  "mastodon_target_version": "4.5.7",
  "description": "Commonshub standard defaults for Mastodon-backed communities.",
  "created_at": "2026-03-07T00:00:00Z",

  "deep_links": {
    "login": "/auth/sign_in",
    "profile": "/settings/profile",
    "verification": "/settings/verification",
    "registrations": "/admin/settings/registrations",
    "branding": "/admin/settings/branding",
    "about": "/admin/settings/about",
    "discovery": "/admin/settings/discovery",
    "invites": "/admin/invites",
    "announcements": "/admin/announcements",
    "rules": "/admin/rules",
    "tags": "/admin/tags",
    "home": "/home",
    "accounts_local": "/admin/accounts?origin=local",
    "reports": "/admin/reports",
    "roles": "/admin/roles",
    "limited_instances": "/admin/instances?limited=1"
  },

  "registration_defaults": {
    "version": "1.0",
    "who_can_sign_up": {
      "value": "nobody",
      "label": "Nobody can sign up",
      "dashboard_recommendation": "Start closed for the initial launch cohort.",
      "notes": "Use a fully closed registration setting during launch. Invite links handle initial access while the community tone and moderation baseline are established."
    },
    "require_reason_to_join": false,
    "minimum_age_requirement": "",
    "fields_render_order": [
      "who_can_sign_up",
      "require_reason_to_join",
      "minimum_age_requirement",
      "custom_message_when_signups_are_not_available"
    ]
  },

  "branding_defaults": {
    "landing_page": "local_feed",
    "notes": "Visitors land on the Local feed so they immediately see live signal."
  },

  "rules_template": {
    "version": "1.0",
    "rules": [
      "Be respectful. Debate ideas — don’t attack people. No harassment, slurs, or intimidation.",
      "Add signal. Share context, sources, or informed perspective. Low-effort trolling and spam will be removed.",
      "Stay on topic. Posts should relate to war, geopolitics, and the core focus of this community.",
      "No self-promotion without participation. Relevant work is welcome when you are actively part of the conversation.",
      "Protect safety and privacy. Do not share personal data, dox, or post information that could put anyone at risk."
    ]
  },

  "privacy_policy_template": {
    "version": "1.0",
    "mode": "templated",
    "template": "Privacy Policy\n\nThis community is operated by Commonshub in partnership with the [CREATOR / SHOW NAME] team.\n\nWe are committed to minimal data collection and transparent operation.\n\n1. What We Collect\nWhen you create an account, we store:\n- The information you provide (username, email, profile details)\n- Your posts and media\n- Basic technical logs necessary to operate the service\n\n2. How Your Data Is Used\nYour data is used only to:\n- Provide and maintain the service\n- Enable federation with other servers\n- Support moderation and community safety\n- Prevent abuse and spam\n\nWe do not sell your data.\nWe do not run advertising.\nWe do not use behavioral tracking.\n\n3. Public Content\nPublic posts are publicly accessible and may be copied, indexed, or shared by other servers in the Fediverse.\n\n4. Media Storage & Backups\nMedia and posts may be stored and backed up on infrastructure used to operate this service.\n\n5. Federation\nBecause this is a federated service:\n- Content may be delivered to other servers\n- Content from other servers may appear here\n\nServers that present safety or policy risks may be blocked.\n\n6. Data Retention\nIf you delete your account, your profile data will be removed.\nSome content may remain in backups or on federated servers.\n\n7. Cookies & Analytics\nOnly essential technical functions are used to keep the service running.\nNo advertising or cross-site tracking is used.\n\n8. Service Hosting\nThis service is hosted in:\n[HOSTING COUNTRY]\n\n9. Contact\nFor privacy questions or data requests, contact:\n[ADMIN EMAIL]",
    "template_variables": [
      "CREATOR / SHOW NAME",
      "HOSTING COUNTRY",
      "ADMIN EMAIL"
    ]
  },

